# Copy to .env.local and fill in values

# Auth.js — generate with: npx auth secret
AUTH_SECRET=""

# Google OAuth — https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# Anthropic — https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=""

# Database (SQLite)
DATABASE_URL="file:./dev.db"

# ── Nano-job-Tracker: nanobot analysis engine ──────────────
# Start it with `nanobot serve` (defaults to 127.0.0.1:8900).
# Only needed if api.apiKey is set in ~/.nanobot/config.json.
NANOBOT_API_URL="http://127.0.0.1:8900"
NANOBOT_API_KEY=""
NANOBOT_MODEL="deepseek-v4-flash"
NANOBOT_TIMEOUT_MS="180000"

# Ceiling on emails pulled in one sync, so a first run against a huge mailbox
# cannot become a surprise bill. Newest mail is kept when the cap bites.
SYNC_MAX_EMAILS="4000"
